[Desktop Entry]
Type=Application
Version=1.0
Name=SyncthingStatus
Name[nb]=SyncthingStatus
Comment=Show Syncthing status in the system tray
Comment[nb]=Vis status for Syncthing i systemkurven
# Small delay so the panel/status area is ready before the icon is added
Exec=sh -c 'sleep 5; exec /usr/bin/syncthing-status'
Icon=syncthing-status
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
